class Solution {
    public int sameMod(int[] arr) {
        int n = arr.length;

        // If all elements are equal, infinitely many k exist
        boolean allSame = true;

        for (int i = 1; i < n; i++) {
            if (arr[i] != arr[0]) {
                allSame = false;
                break;
            }
        }

        if (allSame) {
            return -1;
        }

        // Find GCD of all differences
        int g = 0;

        for (int i = 1; i < n; i++) {
            g = gcd(g, Math.abs(arr[i] - arr[0]));
        }

        // Count divisors of GCD
        int count = 0;

        for (int i = 1; i * i <= g; i++) {
            if (g % i == 0) {
                count++;

                if (i != g / i) {
                    count++;
                }
            }
        }

        return count;
    }

    private int gcd(int a, int b) {
        while (b != 0) {
            int temp = a % b;
            a = b;
            b = temp;
        }

        return a;
    }
}
