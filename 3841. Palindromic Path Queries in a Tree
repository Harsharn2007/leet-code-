
import java.util.*;

class Solution {
    private int LOG;
    private int[] tin, tout, depth, parent, bit;
    private int[][] up;
    private List<Integer>[] adj;
    private char[] chars;
    private int timer;

    public List<Boolean> palindromePath(
            int n, int[][] edges, String s, String[] queries) {

        adj = new ArrayList[n];
        for (int i = 0; i < n; i++) {
            adj[i] = new ArrayList<>();
        }

        for (int[] e : edges) {
            adj[e[0]].add(e[1]);
            adj[e[1]].add(e[0]);
        }

        chars = s.toCharArray();

        LOG = 1;
        while ((1 << LOG) <= n) LOG++;

        tin = new int[n];
        tout = new int[n];
        depth = new int[n];
        parent = new int[n];
        up = new int[LOG][n];
        bit = new int[n + 2];

        buildEulerTour(n);

        // Initialize Fenwick tree with each node's character mask.
        for (int u = 0; u < n; u++) {
            int mask = 1 << (chars[u] - 'a');
            add(tin[u], mask);
            add(tout[u] + 1, mask);
        }

        List<Boolean> answer = new ArrayList<>();

        for (String q : queries) {
            String[] p = q.split(" ");

            if (p[0].equals("update")) {
                int u = Integer.parseInt(p[1]);
                char c = p[2].charAt(0);

                int change = (1 << (chars[u] - 'a'))
                           ^ (1 << (c - 'a'));

                if (change != 0) {
                    chars[u] = c;
                    add(tin[u], change);
                    add(tout[u] + 1, change);
                }
            } else {
                int u = Integer.parseInt(p[1]);
                int v = Integer.parseInt(p[2]);
                int w = lca(u, v);

                int pathMask = prefix(tin[u])
                             ^ prefix(tin[v])
                             ^ (1 << (chars[w] - 'a'));

                answer.add(Integer.bitCount(pathMask) <= 1);
            }
        }

        return answer;
    }

    private void buildEulerTour(int n) {
        int[] iter = new int[n];
        int[] stack = new int[n];
        int top = 0;

        stack[0] = 0;
        parent[0] = 0;

        while (top >= 0) {
            int u = stack[top];

            if (iter[u] == 0) {
                tin[u] = ++timer;
                up[0][u] = parent[u];

                for (int j = 1; j < LOG; j++) {
                    up[j][u] = up[j - 1][up[j - 1][u]];
                }
            }

            if (iter[u] < adj[u].size()) {
                int v = adj[u].get(iter[u]++);

                if (v == parent[u]) continue;

                parent[v] = u;
                depth[v] = depth[u] + 1;
                stack[++top] = v;
            } else {
                tout[u] = timer;
                top--;
            }
        }
    }

    private void add(int i, int val) {
        for (; i < bit.length; i += i & -i) {
            bit[i] ^= val;
        }
    }

    private int prefix(int i) {
        int res = 0;

        for (; i > 0; i -= i & -i) {
            res ^= bit[i];
        }

        return res;
    }

    private int lca(int u, int v) {
        if (depth[u] < depth[v]) {
            int t = u;
            u = v;
            v = t;
        }

        int diff = depth[u] - depth[v];

        for (int j = 0; j < LOG; j++) {
            if ((diff & (1 << j)) != 0) {
                u = up[j][u];
            }
        }

        if (u == v) return u;

        for (int j = LOG - 1; j >= 0; j--) {
            if (up[j][u] != up[j][v]) {
                u = up[j][u];
                v = up[j][v];
            }
        }

        return parent[u];
    }
}
