class Solution {
    public int maxSum(List<Integer> nums, int k) {
        int MOD = 1_000_000_007;
        int n = nums.size();

        int[] bitCount = new int[32];

        // Count how many numbers contain each bit
        for (int num : nums) {
            for (int b = 0; b < 32; b++) {
                if ((num & (1 << b)) != 0) {
                    bitCount[b]++;
                }
            }
        }

        long ans = 0;

        // Build k maximum numbers greedily
        for (int i = 0; i < k; i++) {
            long value = 0;

            for (int b = 31; b >= 0; b--) {
                if (bitCount[b] > 0) {
                    value |= (1L << b);
                    bitCount[b]--;
                }
            }

            ans = (ans + value * value) % MOD;
        }

        return (int) ans;
    }
}
