
import java.util.*;

class Solution {
    boolean checkPath(ArrayList<ArrayList<Integer>> adj, int src, int dest) {

        int V = adj.size();

        boolean[] visited = new boolean[V];

        Queue<Integer> q = new LinkedList<>();

        q.add(src);
        visited[src] = true;

        while (!q.isEmpty()) {

            int node = q.poll();

            if (node == dest) {
                return true;
            }

            for (int neighbor : adj.get(node)) {

                if (!visited[neighbor]) {
                    visited[neighbor] = true;
                    q.add(neighbor);
                }
            }
        }

        return false;
    }
}
