class Solution {
    public int smallestIndex(int[] nums) {
        for (int i = 0; i < nums.length; i++) {
            int num = nums[i];
            int sum = 0;

            // Calculate sum of digits
            while (num > 0) {
                sum += num % 10;
                num /= 10;
            }

            // Check if digit sum equals index
            if (sum == i) {
                return i;
            }
        }

        return -1;
    }
}
