
class Solution:
    def findPattern(self, s):
        i = 0
        n = len(s)

        while i < n:
            count_x = 0
            count_y = 0

            while i < n and s[i] == 'x':
                count_x += 1
                i += 1

            while i < n and s[i] == 'y':
                count_y += 1
                i += 1

            if count_x == 0 or count_x != count_y:
                return False

        return True
