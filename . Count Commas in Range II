class Solution {
    public long countCommas(long n) {
        long ans = 0;

        // 1 comma: 1,000 to 999,999
        if (n >= 1000) {
            ans += Math.min(n, 999999L) - 1000 + 1;
        }

        // 2 commas: 1,000,000 to 999,999,999
        if (n >= 1000000) {
            ans += 2 * (Math.min(n, 999999999L) - 1000000 + 1);
        }

        // 3 commas: 1,000,000,000 to 999,999,999,999
        if (n >= 1000000000) {
            ans += 3 * (Math.min(n, 999999999999L) - 1000000000 + 1);
        }

        // 4 commas: 1,000,000,000,000 to 999,999,999,999,999
        if (n >= 1000000000000L) {
            ans += 4 * (Math.min(n, 999999999999999L) - 1000000000000L + 1);
        }

        // 5 commas: 1,000,000,000,000,000 onward
        if (n >= 1000000000000000L) {
            ans += 5 * (n - 1000000000000000L + 1);
        }

        return ans;
    }
}
