class Solution:
    def minimumChanges(self, s, k):
        n = len(s)
        INF = float('inf')

        cost = [[0] * n for _ in range(n)]

        for i in range(n):
            for j in range(i + 1, n):
                length = j - i + 1
                best = INF

                for d in range(1, length):
                    if length % d != 0:
                        continue

                    changes = 0
                    groups = length // d

                    for r in range(d):
                        left = i + r
                        right = i + r + (groups - 1) * d

                        while left < right:
                            if s[left] != s[right]:
                                changes += 1
                            left += d
                            right -= d

                    best = min(best, changes)

                cost[i][j] = best

        dp = [[INF] * (n + 1) for _ in range(k + 1)]
        dp[0][0] = 0

        for p in range(1, k + 1):
            for end in range(2 * p, n + 1):
                for start in range(2 * (p - 1), end - 1):
                    dp[p][end] = min(
                        dp[p][end],
                        dp[p - 1][start] + cost[start][end - 1]
                    )

        return dp[k][n]
