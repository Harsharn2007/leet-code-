class Solution {
public:
    static const int MOD = 1000000007;

    int numberOfSets(int n, int k) {
        vector<vector<long long>> dp(n, vector<long long>(k + 1));

        // 0 segments = 1 way
        for (int i = 0; i < n; i++) {
            dp[i][0] = 1;
        }

        for (int j = 1; j <= k; j++) {
            long long sum = 0;

            for (int i = 1; i < n; i++) {
                // Add configurations where the previous
                // segments use points up to i-1.
                sum = (sum + dp[i - 1][j - 1]) % MOD;

                // Don't end a segment at i
                dp[i][j] = dp[i - 1][j];

                // Create a segment whose right endpoint is i.
                // The segment must have a different left endpoint.
                if (i >= 1) {
                    dp[i][j] = (dp[i][j] + sum) % MOD;
                }
            }
        }

        return dp[n - 1][k];
    }
};
